{
  "schema": "aibo.plugin-manifest/v2",
  "pluginId": "dev.aibo.claude-code",
  "version": "0.4.6",
  "displayName": "Claude Code",
  "description": "Claude Code sessions through the packaged ACP adapter. Requires a locally installed Claude Code CLI.",
  "hostSdk": {
    "min": "0.1.9",
    "maxExclusive": "0.2.0"
  },
  "host": {
    "min": "0.1.0",
    "maxExclusive": "0.2.0"
  },
  "platforms": [
    "darwin-arm64"
  ],
  "protocols": {
    "runtime": {
      "min": "2.1",
      "max": "2.1"
    }
  },
  "entrypoint": {
    "executable": "worker.mjs"
  },
  "executableDependencies": [
    {
      "kind": "runtime",
      "name": "node",
      "versionRange": ">=22",
      "required": true
    },
    {
      "kind": "executable",
      "name": "claude",
      "versionRange": ">=2.1.280",
      "required": true
    }
  ],
  "contributions": [
    {
      "kind": "capabilityProvider",
      "id": "dev.aibo.claude-code.agent",
      "scope": "session",
      "required": true,
      "displayName": "Claude Code",
      "icon": {
        "path": "M4.709 15.955l4.72-2.647.08-.23-.08-.128H9.2l-.79-.048-2.698-.073-2.339-.097-2.266-.122-.571-.121L0 11.784l.055-.352.48-.321.686.06 1.52.103 2.278.158 1.652.097 2.449.255h.389l.055-.157-.134-.098-.103-.097-2.358-1.596-2.552-1.688-1.336-.972-.724-.491-.364-.462-.158-1.008.656-.722.881.06.225.061.893.686 1.908 1.476 2.491 1.833.365.304.145-.103.019-.073-.164-.274-1.355-2.446-1.446-2.49-.644-1.032-.17-.619a2.97 2.97 0 01-.104-.729L6.283.134 6.696 0l.996.134.42.364.62 1.414 1.002 2.229 1.555 3.03.456.898.243.832.091.255h.158V9.01l.128-1.706.237-2.095.23-2.695.08-.76.376-.91.747-.492.584.28.48.685-.067.444-.286 1.851-.559 2.903-.364 1.942h.212l.243-.242.985-1.306 1.652-2.064.73-.82.85-.904.547-.431h1.033l.76 1.129-.34 1.166-1.064 1.347-.881 1.142-1.264 1.7-.79 1.36.073.11.188-.02 2.856-.606 1.543-.28 1.841-.315.833.388.091.395-.328.807-1.969.486-2.309.462-3.439.813-.042.03.049.061 1.549.146.662.036h1.622l3.02.225.79.522.474.638-.079.485-1.215.62-1.64-.389-3.829-.91-1.312-.329h-.182v.11l1.093 1.068 2.006 1.81 2.509 2.33.127.578-.322.455-.34-.049-2.205-1.657-.851-.747-1.926-1.62h-.128v.17l.444.649 2.345 3.521.122 1.08-.17.353-.608.213-.668-.122-1.374-1.925-1.415-2.167-1.143-1.943-.14.08-.674 7.254-.316.37-.729.28-.607-.461-.322-.747.322-1.476.389-1.924.315-1.53.286-1.9.17-.632-.012-.042-.14.018-1.434 1.967-2.18 2.945-1.726 1.845-.414.164-.717-.37.067-.662.401-.589 2.388-3.036 1.44-1.882.93-1.086-.006-.158h-.055L4.132 18.56l-1.13.146-.487-.456.061-.746.231-.243 1.908-1.312-.006.006z"
      },
      "executionPolicy": "agent-managed",
      "sessionControls": [
        {
          "id": "manual",
          "kind": "mode",
          "label": "Manual",
          "description": "Claude Code Manual mode: edits and commands ask for approval in Aibo; Claude Code manages its own permissions, no workspace sandbox.",
          "command": "manual",
          "profile": {
            "interactionMode": "edit",
            "filesystemPolicy": "agent-managed",
            "commandPolicy": "agent-managed",
            "networkPolicy": "agent-managed",
            "approvalPolicy": "on-request",
            "approvalReviewer": "user"
          }
        },
        {
          "id": "auto",
          "kind": "mode",
          "label": "Auto",
          "description": "Claude Code Auto mode: Claude's own classifier reviews edits and commands, and only asks Aibo when it must; no workspace sandbox. Depends on the model and organization settings.",
          "command": "auto",
          "profile": {
            "interactionMode": "edit",
            "filesystemPolicy": "agent-managed",
            "commandPolicy": "agent-managed",
            "networkPolicy": "agent-managed",
            "approvalPolicy": "on-request",
            "approvalReviewer": "auto-review"
          }
        },
        {
          "id": "plan",
          "kind": "mode",
          "label": "Plan",
          "command": "plan",
          "description": "Claude Code Plan mode: analyzes and plans without editing files; approving the plan in Aibo switches to Manual or Auto.",
          "profile": {
            "interactionMode": "plan",
            "filesystemPolicy": "read-only",
            "commandPolicy": "disabled",
            "networkPolicy": "agent-managed",
            "approvalPolicy": "never",
            "approvalReviewer": "none"
          },
          "transitions": [
            "manual",
            "auto"
          ]
        }
      ],
      "operations": [
        {
          "id": "dev.aibo.claude-code.operation.command-list",
          "capability": {
            "id": "dev.aibo.claude-code.command.list",
            "version": "1.0.0"
          },
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "action": {
                "const": "get"
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "properties": {
              "recovery": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "recovery",
              "capabilities"
            ]
          },
          "effect": "read",
          "permissions": [
            "workspace.read"
          ],
          "timeoutMs": 15000,
          "idempotent": true
        },
        {
          "id": "dev.aibo.claude-code.operation.model-context-window",
          "capability": {
            "id": "dev.aibo.claude-code.model.context-window",
            "version": "1.0.0"
          },
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "enum": [
                  "list",
                  "set"
                ]
              },
              "contextWindow": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "properties": {
              "recovery": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "recovery",
              "capabilities"
            ]
          },
          "effect": "read",
          "permissions": [
            "workspace.read"
          ],
          "timeoutMs": 30000,
          "idempotent": false
        },
        {
          "id": "dev.aibo.claude-code.operation.model-reasoning",
          "capability": {
            "id": "dev.aibo.claude-code.model.reasoning",
            "version": "1.0.0"
          },
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "enum": [
                  "list",
                  "set"
                ]
              },
              "level": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "properties": {
              "recovery": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "recovery",
              "capabilities"
            ]
          },
          "effect": "read",
          "permissions": [
            "workspace.read"
          ],
          "timeoutMs": 30000,
          "idempotent": false
        },
        {
          "id": "dev.aibo.claude-code.operation.model-select",
          "capability": {
            "id": "dev.aibo.claude-code.model.select",
            "version": "1.0.0"
          },
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "enum": [
                  "list",
                  "set"
                ]
              },
              "reference": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "properties": {
              "recovery": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "parameterScope": {
                "enum": [
                  "all-models",
                  "current-model"
                ]
              }
            },
            "required": [
              "recovery",
              "capabilities",
              "parameterScope"
            ]
          },
          "effect": "read",
          "permissions": [
            "workspace.read"
          ],
          "timeoutMs": 30000,
          "idempotent": false
        },
        {
          "id": "dev.aibo.claude-code.session.open",
          "capability": {
            "id": "aibo.session.open",
            "version": "1.0.0"
          },
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode",
              "executionProfile"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "create",
                  "resume"
                ]
              },
              "executionProfile": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "schema": {
                    "type": "string"
                  },
                  "interactionMode": {
                    "enum": [
                      "ask",
                      "plan",
                      "edit"
                    ]
                  },
                  "approvalPolicy": {
                    "type": "string"
                  },
                  "approvalReviewer": {
                    "enum": [
                      "user",
                      "auto-review",
                      "none"
                    ]
                  },
                  "filesystemPolicy": {
                    "type": "string"
                  },
                  "commandPolicy": {
                    "type": "string"
                  },
                  "networkPolicy": {
                    "type": "string"
                  },
                  "model": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "reasoningEffort": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              "recovery": {
                "type": [
                  "object",
                  "null"
                ]
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "required": [
              "nativeSessionId",
              "recovery",
              "capabilities"
            ],
            "properties": {
              "nativeSessionId": {
                "type": "string",
                "minLength": 1
              },
              "recovery": {
                "type": "object"
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "effect": "read",
          "permissions": [
            "workspace.read"
          ],
          "timeoutMs": 120000,
          "idempotent": false
        },
        {
          "id": "dev.aibo.claude-code.session.turn",
          "capability": {
            "id": "aibo.session.turn",
            "version": "1.0.0"
          },
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200000
              },
              "attachments": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "object"
                }
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "required": [
              "status",
              "recovery"
            ],
            "properties": {
              "status": {
                "enum": [
                  "completed",
                  "interrupted",
                  "failed"
                ]
              },
              "recovery": {
                "type": [
                  "object",
                  "null"
                ]
              }
            }
          },
          "effect": "read",
          "permissions": [
            "workspace.read"
          ],
          "timeoutMs": 43200000,
          "idempotent": false
        },
        {
          "id": "dev.aibo.claude-code.session.turn.write",
          "capability": {
            "id": "aibo.session.turn.write",
            "version": "1.0.0"
          },
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200000
              },
              "attachments": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "object"
                }
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "required": [
              "status",
              "recovery"
            ],
            "properties": {
              "status": {
                "enum": [
                  "completed",
                  "interrupted",
                  "failed"
                ]
              },
              "recovery": {
                "type": [
                  "object",
                  "null"
                ]
              }
            }
          },
          "effect": "write",
          "permissions": [
            "workspace.read",
            "workspace.write"
          ],
          "timeoutMs": 43200000,
          "idempotent": false
        },
        {
          "id": "dev.aibo.claude-code.session.cancel",
          "capability": {
            "id": "aibo.session.cancel",
            "version": "1.0.0"
          },
          "inputSchema": {
            "type": "object",
            "additionalProperties": false
          },
          "outputSchema": {
            "type": "object",
            "required": [
              "accepted"
            ],
            "properties": {
              "accepted": {
                "const": true
              }
            }
          },
          "effect": "read",
          "permissions": [
            "workspace.read"
          ],
          "timeoutMs": 15000,
          "idempotent": false
        },
        {
          "id": "dev.aibo.claude-code.session.close",
          "capability": {
            "id": "aibo.session.close",
            "version": "1.0.0"
          },
          "inputSchema": {
            "type": "object",
            "additionalProperties": false
          },
          "outputSchema": {
            "type": "object",
            "required": [
              "accepted"
            ],
            "properties": {
              "accepted": {
                "const": true
              }
            }
          },
          "effect": "read",
          "permissions": [
            "workspace.read"
          ],
          "timeoutMs": 15000,
          "idempotent": false
        },
        {
          "id": "dev.aibo.claude-code.operation.approval",
          "capability": {
            "id": "dev.aibo.claude-code.approval.respond",
            "version": "1.0.0"
          },
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "requestId",
              "optionId"
            ],
            "properties": {
              "requestId": {
                "type": "string",
                "minLength": 1
              },
              "optionId": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "resolved",
              "recovery",
              "capabilities"
            ],
            "properties": {
              "resolved": {
                "const": true
              },
              "recovery": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "effect": "read",
          "permissions": [
            "workspace.read"
          ],
          "timeoutMs": 120000,
          "idempotent": false
        },
        {
          "id": "dev.aibo.claude-code.operation.user-input",
          "capability": {
            "id": "dev.aibo.claude-code.user-input.respond",
            "version": "1.0.0"
          },
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "requestId",
              "answers"
            ],
            "properties": {
              "requestId": {
                "type": "string",
                "minLength": 1
              },
              "answers": {
                "type": "object"
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "resolved",
              "recovery",
              "capabilities"
            ],
            "properties": {
              "resolved": {
                "const": true
              },
              "recovery": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "effect": "read",
          "permissions": [
            "workspace.read"
          ],
          "timeoutMs": 120000,
          "idempotent": false
        },
        {
          "id": "dev.aibo.claude-code.operation.background-tasks-list",
          "capability": {
            "id": "dev.aibo.claude-code.background-tasks.list",
            "version": "1.0.0"
          },
          "effect": "read",
          "permissions": [
            "workspace.read"
          ],
          "timeoutMs": 15000,
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {}
          },
          "outputSchema": {
            "type": "object",
            "required": [
              "tasks",
              "recovery",
              "capabilities"
            ],
            "properties": {
              "tasks": {
                "type": "array",
                "maxItems": 128,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "rootTurnId",
                    "name",
                    "command",
                    "status",
                    "activity"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "maxLength": 4000,
                      "minLength": 1
                    },
                    "rootTurnId": {
                      "type": "string",
                      "maxLength": 4000,
                      "minLength": 1
                    },
                    "name": {
                      "type": "string",
                      "maxLength": 4000
                    },
                    "command": {
                      "type": "string",
                      "maxLength": 4000
                    },
                    "activity": {
                      "type": "string",
                      "maxLength": 12000
                    },
                    "outputPath": {
                      "type": "string",
                      "maxLength": 4000
                    },
                    "status": {
                      "enum": [
                        "running",
                        "completed",
                        "failed",
                        "stopped",
                        "unknown"
                      ]
                    },
                    "exitCode": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    }
                  }
                }
              },
              "recovery": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "idempotent": true
        }
      ]
    }
  ],
  "authentication": {
    "kind": "cli-terminal",
    "executable": "claude",
    "loginArgs": [
      "auth",
      "login"
    ],
    "statusArgs": [
      "auth",
      "status"
    ]
  }
}
