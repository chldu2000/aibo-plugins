{
  "schema": "aibo.acp-agent/v1",
  "label": "Claude Code",
  "modes": {
    "plan": "plan",
    "edit": "default",
    "auto": "auto"
  },
  "persistsEmptySessions": false,
  "requestPrefix": "claude",
  "approvalOptions": [
    {
      "optionId": "exit-plan-clear-auto",
      "toolKind": "switch_mode",
      "label": "清空上下文，批准计划并使用 Auto",
      "sessionControl": "auto",
      "contextReset": true
    },
    {
      "optionId": "exit-plan-auto",
      "toolKind": "switch_mode",
      "label": "批准计划并使用 Auto",
      "sessionControl": "auto"
    },
    {
      "optionId": "exit-plan-default",
      "toolKind": "switch_mode",
      "label": "批准计划，手动审批编辑",
      "sessionControl": "manual"
    },
    {
      "optionId": "reject",
      "toolKind": "switch_mode",
      "label": "继续规划"
    }
  ],
  "elicitation": true,
  "launch": {
    "kind": "node",
    "entry": "launch-acp.mjs"
  },
  "parameterScope": "current-model"
}
