{
  "schema": "aibo.plugin-manifest/v2",
  "pluginId": "dev.aibo.cursor",
  "version": "0.1.16",
  "displayName": "Cursor",
  "description": "Cursor Agent sessions through the official ACP interface.",
  "hostSdk": { "min": "0.1.0", "maxExclusive": "0.2.0" },
  "host": { "min": "0.1.0", "maxExclusive": "0.2.0" },
  "platforms": ["darwin-arm64"],
  "protocols": { "runtime": { "min": "2.1", "max": "2.1" } },
  "entrypoint": { "executable": "worker.mjs" },
  "executableDependencies": [
    { "kind": "runtime", "name": "node", "versionRange": ">=22", "required": true },
    { "kind": "executable", "name": "agent", "required": true }
  ],
  "contributions": [
    {
      "kind": "capabilityProvider",
      "id": "dev.aibo.cursor.agent",
      "scope": "session",
      "required": true,
      "displayName": "Cursor",
      "icon": {
        "path": "M21.26428 6.20716L12.45708 1.12239c-0.28281 -0.16332 -0.63177 -0.16332 -0.91458 0L2.73572 6.20716c-0.23774 0.13727 -0.38452 0.39114 -0.38452 0.66609v10.25349c0 0.27495 0.14678 0.52882 0.38452 0.66609l8.80719 5.08478c0.28281 0.16332 0.63177 0.16332 0.91458 0l8.80719 -5.08478c0.23774 -0.13727 0.38452 -0.39114 0.38452 -0.66609v-10.25349c0 -0.27495 -0.14678 -0.52882 -0.38452 -0.66609h-0.00041ZM20.71106 7.28424l-8.50206 14.72593c-0.05747 0.09923 -0.20921 0.05871 -0.20921 -0.05623v-9.64239c0 -0.19267 -0.10295 -0.37088 -0.26999 -0.46763L3.37948 7.02293c-0.09923 -0.05747 -0.05871 -0.20921 0.05623 -0.20921h17.00412c0.24146 0 0.39238 0.26172 0.27165 0.47094h-0.00041Z"
      },
      "executionPolicy": "agent-managed",
      "sessionControls": [
        {
          "id": "agent",
          "kind": "mode",
          "label": "Agent",
          "description": "执行任务并修改文件；Cursor 管理文件、命令和网络权限，aibo 转发审批，不提供工作区沙箱",
          "command": "agent",
          "profile": {
            "interactionMode": "edit",
            "filesystemPolicy": "agent-managed",
            "commandPolicy": "agent-managed",
            "networkPolicy": "agent-managed",
            "approvalPolicy": "on-request",
            "approvalReviewer": "user"
          }
        },
        {
          "id": "ask",
          "kind": "mode",
          "label": "Ask",
          "description": "只读问答；由 Cursor 原生模式限制工具行为",
          "command": "ask",
          "profile": {
            "interactionMode": "ask",
            "filesystemPolicy": "read-only",
            "commandPolicy": "disabled",
            "networkPolicy": "agent-managed",
            "approvalPolicy": "never",
            "approvalReviewer": "none"
          }
        },
        {
          "id": "plan",
          "kind": "mode",
          "label": "Plan",
          "description": "分析需求、制定计划；由 Cursor 原生模式限制工具行为",
          "command": "plan",
          "profile": {
            "interactionMode": "plan",
            "filesystemPolicy": "read-only",
            "commandPolicy": "disabled",
            "networkPolicy": "agent-managed",
            "approvalPolicy": "never",
            "approvalReviewer": "none"
          }
        }
      ],
      "settings": {
        "schema": "aibo.agent-settings/v1",
        "version": 1,
        "title": "Cursor 设置",
        "description": "每次发送消息时应用；会话设置覆盖项目设置，项目设置覆盖全局设置。",
        "scopes": ["application", "workspace", "session"],
        "fields": [
          {
            "key": "additionalInstructions",
            "label": "附加指令",
            "description": "在发送给 Cursor 的每条消息前附加这些指令。",
            "type": "multiline",
            "default": "",
            "maxLength": 8000
          }
        ]
      },
      "operations": [
        {
          "id": "dev.aibo.cursor.operation.command-list",
          "capability": {
            "id": "dev.aibo.cursor.command.list",
            "version": "1.0.0"
          },
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "action": {
                "const": "get"
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "properties": {
              "recovery": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "recovery",
              "capabilities"
            ]
          },
          "effect": "read",
          "permissions": [
            "workspace.read"
          ],
          "timeoutMs": 15000,
          "idempotent": true
        },
        {
          "id": "dev.aibo.cursor.operation.model-context-window",
          "capability": {
            "id": "dev.aibo.cursor.model.context-window",
            "version": "1.0.0"
          },
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "enum": [
                  "list",
                  "set"
                ]
              },
              "contextWindow": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "properties": {
              "recovery": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "recovery",
              "capabilities"
            ]
          },
          "effect": "read",
          "permissions": [
            "workspace.read"
          ],
          "timeoutMs": 30000,
          "idempotent": false
        },
        {
          "id": "dev.aibo.cursor.operation.model-reasoning",
          "capability": {
            "id": "dev.aibo.cursor.model.reasoning",
            "version": "1.0.0"
          },
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "enum": [
                  "list",
                  "set"
                ]
              },
              "level": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "properties": {
              "recovery": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "recovery",
              "capabilities"
            ]
          },
          "effect": "read",
          "permissions": [
            "workspace.read"
          ],
          "timeoutMs": 30000,
          "idempotent": false
        },
        {
          "id": "dev.aibo.cursor.operation.model-select",
          "capability": {
            "id": "dev.aibo.cursor.model.select",
            "version": "1.0.0"
          },
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "enum": [
                  "list",
                  "set"
                ]
              },
              "reference": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "properties": {
              "recovery": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "recovery",
              "capabilities"
            ]
          },
          "effect": "read",
          "permissions": [
            "workspace.read"
          ],
          "timeoutMs": 30000,
          "idempotent": false
        },
        {
          "id": "dev.aibo.cursor.session.open",
          "capability": { "id": "aibo.session.open", "version": "1.0.0" },
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "executionProfile"],
            "properties": {
              "mode": { "enum": ["create", "resume"] },
              "executionProfile": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "schema": { "type": "string" },
                  "interactionMode": { "enum": ["ask", "plan", "edit"] },
                  "approvalPolicy": { "type": "string" },
                  "approvalReviewer": { "enum": ["user", "auto-review", "none"] },
                  "filesystemPolicy": { "type": "string" },
                  "commandPolicy": { "type": "string" },
                  "networkPolicy": { "type": "string" },
                  "model": { "type": ["string", "null"] },
                  "reasoningEffort": { "type": ["string", "null"] }
                }
              },
              "recovery": { "type": ["object", "null"] }
            }
          },
          "outputSchema": {
            "type": "object",
            "required": ["nativeSessionId", "recovery", "capabilities"],
            "properties": {
              "nativeSessionId": { "type": "string", "minLength": 1 },
              "recovery": { "type": "object" },
              "capabilities": { "type": "array", "items": { "type": "string" } }
            }
          },
          "effect": "read",
          "permissions": ["workspace.read"],
          "timeoutMs": 120000,
          "idempotent": false
        },
        {
          "id": "dev.aibo.cursor.session.turn",
          "capability": { "id": "aibo.session.turn", "version": "1.0.0" },
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": {
              "text": { "type": "string", "minLength": 1, "maxLength": 200000 },
              "attachments": { "type": "array", "maxItems": 100, "items": { "type": "object" } }
            }
          },
          "outputSchema": {
            "type": "object",
            "required": ["status", "recovery"],
            "properties": {
              "status": { "enum": ["completed", "interrupted", "failed"] },
              "recovery": { "type": ["object", "null"] }
            }
          },
          "effect": "read",
          "permissions": ["workspace.read"],
          "timeoutMs": 43200000,
          "idempotent": false
        },
        {
          "id": "dev.aibo.cursor.session.turn.write",
          "capability": { "id": "aibo.session.turn.write", "version": "1.0.0" },
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": {
              "text": { "type": "string", "minLength": 1, "maxLength": 200000 },
              "attachments": { "type": "array", "maxItems": 100, "items": { "type": "object" } }
            }
          },
          "outputSchema": {
            "type": "object",
            "required": ["status", "recovery"],
            "properties": {
              "status": { "enum": ["completed", "interrupted", "failed"] },
              "recovery": { "type": ["object", "null"] }
            }
          },
          "effect": "write",
          "permissions": ["workspace.read", "workspace.write"],
          "timeoutMs": 43200000,
          "idempotent": false
        },
        {
          "id": "dev.aibo.cursor.session.cancel",
          "capability": { "id": "aibo.session.cancel", "version": "1.0.0" },
          "inputSchema": { "type": "object", "additionalProperties": false },
          "outputSchema": {
            "type": "object",
            "required": ["accepted"],
            "properties": { "accepted": { "const": true } }
          },
          "effect": "read",
          "permissions": ["workspace.read"],
          "timeoutMs": 15000,
          "idempotent": false
        },
        {
          "id": "dev.aibo.cursor.session.close",
          "capability": { "id": "aibo.session.close", "version": "1.0.0" },
          "inputSchema": { "type": "object", "additionalProperties": false },
          "outputSchema": {
            "type": "object",
            "required": ["accepted"],
            "properties": { "accepted": { "const": true } }
          },
          "effect": "read",
          "permissions": ["workspace.read"],
          "timeoutMs": 15000,
          "idempotent": false
        },
        {
          "id": "dev.aibo.cursor.operation.approval",
          "capability": { "id": "dev.aibo.cursor.approval.respond", "version": "1.0.0" },
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requestId", "decision"],
            "properties": {
              "requestId": { "type": "string", "minLength": 1 },
              "decision": { "enum": ["accept", "cancel"] }
            }
          },
          "outputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["resolved", "recovery", "capabilities"],
            "properties": {
              "resolved": { "const": true },
              "recovery": { "type": ["object", "null"] },
              "capabilities": { "type": "array", "items": { "type": "string" } }
            }
          },
          "effect": "read",
          "permissions": ["workspace.read"],
          "timeoutMs": 120000,
          "idempotent": false
        },
        {
          "id": "dev.aibo.cursor.operation.user-input",
          "capability": { "id": "dev.aibo.cursor.user-input.respond", "version": "1.0.0" },
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requestId", "answers"],
            "properties": {
              "requestId": { "type": "string", "minLength": 1 },
              "answers": { "type": "object" }
            }
          },
          "outputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["resolved", "recovery", "capabilities"],
            "properties": {
              "resolved": { "const": true },
              "recovery": { "type": ["object", "null"] },
              "capabilities": { "type": "array", "items": { "type": "string" } }
            }
          },
          "effect": "read",
          "permissions": ["workspace.read"],
          "timeoutMs": 120000,
          "idempotent": false
        }
      ]
    }
  ]
}
