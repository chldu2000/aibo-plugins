{
  "schema": "aibo.plugin-manifest/v2",
  "pluginId": "org.example.acp-agent",
  "version": "0.1.1",
  "displayName": "My ACP Agent",
  "description": "Starter provider for an ACP agent; edit acp.json and the dependency name.",
  "hostSdk": {
    "min": "0.1.8",
    "maxExclusive": "0.2.0"
  },
  "host": {
    "min": "0.1.0",
    "maxExclusive": "0.2.0"
  },
  "platforms": [
    "darwin-arm64"
  ],
  "protocols": {
    "runtime": {
      "min": "2.1",
      "max": "2.1"
    }
  },
  "entrypoint": {
    "executable": "worker.mjs"
  },
  "executableDependencies": [
    {
      "kind": "runtime",
      "name": "node",
      "versionRange": ">=22",
      "required": true
    },
    {
      "kind": "executable",
      "name": "my-acp-agent",
      "required": true
    }
  ],
  "contributions": [
    {
      "kind": "capabilityProvider",
      "id": "org.example.acp-agent.agent",
      "scope": "session",
      "required": true,
      "displayName": "My ACP Agent",
      "executionPolicy": "agent-managed",
      "sessionControls": [
        {
          "id": "code",
          "kind": "mode",
          "label": "Code",
          "description": "Edits files; the agent manages its own permissions and asks for approval.",
          "command": "code",
          "profile": {
            "interactionMode": "edit",
            "filesystemPolicy": "agent-managed",
            "commandPolicy": "agent-managed",
            "networkPolicy": "agent-managed",
            "approvalPolicy": "on-request",
            "approvalReviewer": "user"
          }
        },
        {
          "id": "ask",
          "kind": "mode",
          "label": "Ask",
          "description": "Read-only questions.",
          "command": "ask",
          "profile": {
            "interactionMode": "ask",
            "filesystemPolicy": "read-only",
            "commandPolicy": "disabled",
            "networkPolicy": "agent-managed",
            "approvalPolicy": "never",
            "approvalReviewer": "none"
          }
        }
      ],
      "operations": [
        {
          "id": "org.example.acp-agent.operation.command-list",
          "capability": {
            "id": "org.example.acp-agent.command.list",
            "version": "1.0.0"
          },
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "action": {
                "const": "get"
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "properties": {
              "recovery": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "recovery",
              "capabilities"
            ]
          },
          "effect": "read",
          "permissions": [
            "workspace.read"
          ],
          "timeoutMs": 15000,
          "idempotent": true
        },
        {
          "id": "org.example.acp-agent.operation.model-context-window",
          "capability": {
            "id": "org.example.acp-agent.model.context-window",
            "version": "1.0.0"
          },
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "enum": [
                  "list",
                  "set"
                ]
              },
              "contextWindow": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "properties": {
              "recovery": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "recovery",
              "capabilities"
            ]
          },
          "effect": "read",
          "permissions": [
            "workspace.read"
          ],
          "timeoutMs": 30000,
          "idempotent": false
        },
        {
          "id": "org.example.acp-agent.operation.model-reasoning",
          "capability": {
            "id": "org.example.acp-agent.model.reasoning",
            "version": "1.0.0"
          },
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "enum": [
                  "list",
                  "set"
                ]
              },
              "level": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "properties": {
              "recovery": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "recovery",
              "capabilities"
            ]
          },
          "effect": "read",
          "permissions": [
            "workspace.read"
          ],
          "timeoutMs": 30000,
          "idempotent": false
        },
        {
          "id": "org.example.acp-agent.operation.model-select",
          "capability": {
            "id": "org.example.acp-agent.model.select",
            "version": "1.0.0"
          },
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "enum": [
                  "list",
                  "set"
                ]
              },
              "reference": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "properties": {
              "recovery": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "recovery",
              "capabilities"
            ]
          },
          "effect": "read",
          "permissions": [
            "workspace.read"
          ],
          "timeoutMs": 30000,
          "idempotent": false
        },
        {
          "id": "org.example.acp-agent.session.open",
          "capability": {
            "id": "aibo.session.open",
            "version": "1.0.0"
          },
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode",
              "executionProfile"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "create",
                  "resume"
                ]
              },
              "executionProfile": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "schema": {
                    "type": "string"
                  },
                  "interactionMode": {
                    "enum": [
                      "ask",
                      "plan",
                      "edit"
                    ]
                  },
                  "approvalPolicy": {
                    "type": "string"
                  },
                  "approvalReviewer": {
                    "enum": [
                      "user",
                      "auto-review",
                      "none"
                    ]
                  },
                  "filesystemPolicy": {
                    "type": "string"
                  },
                  "commandPolicy": {
                    "type": "string"
                  },
                  "networkPolicy": {
                    "type": "string"
                  },
                  "model": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "reasoningEffort": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              "recovery": {
                "type": [
                  "object",
                  "null"
                ]
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "required": [
              "nativeSessionId",
              "recovery",
              "capabilities"
            ],
            "properties": {
              "nativeSessionId": {
                "type": "string",
                "minLength": 1
              },
              "recovery": {
                "type": "object"
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "effect": "read",
          "permissions": [
            "workspace.read"
          ],
          "timeoutMs": 120000,
          "idempotent": false
        },
        {
          "id": "org.example.acp-agent.session.turn",
          "capability": {
            "id": "aibo.session.turn",
            "version": "1.0.0"
          },
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200000
              },
              "attachments": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "object"
                }
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "required": [
              "status",
              "recovery"
            ],
            "properties": {
              "status": {
                "enum": [
                  "completed",
                  "interrupted",
                  "failed"
                ]
              },
              "recovery": {
                "type": [
                  "object",
                  "null"
                ]
              }
            }
          },
          "effect": "read",
          "permissions": [
            "workspace.read"
          ],
          "timeoutMs": 43200000,
          "idempotent": false
        },
        {
          "id": "org.example.acp-agent.session.turn.write",
          "capability": {
            "id": "aibo.session.turn.write",
            "version": "1.0.0"
          },
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200000
              },
              "attachments": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "object"
                }
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "required": [
              "status",
              "recovery"
            ],
            "properties": {
              "status": {
                "enum": [
                  "completed",
                  "interrupted",
                  "failed"
                ]
              },
              "recovery": {
                "type": [
                  "object",
                  "null"
                ]
              }
            }
          },
          "effect": "write",
          "permissions": [
            "workspace.read",
            "workspace.write"
          ],
          "timeoutMs": 43200000,
          "idempotent": false
        },
        {
          "id": "org.example.acp-agent.session.cancel",
          "capability": {
            "id": "aibo.session.cancel",
            "version": "1.0.0"
          },
          "inputSchema": {
            "type": "object",
            "additionalProperties": false
          },
          "outputSchema": {
            "type": "object",
            "required": [
              "accepted"
            ],
            "properties": {
              "accepted": {
                "const": true
              }
            }
          },
          "effect": "read",
          "permissions": [
            "workspace.read"
          ],
          "timeoutMs": 15000,
          "idempotent": false
        },
        {
          "id": "org.example.acp-agent.session.close",
          "capability": {
            "id": "aibo.session.close",
            "version": "1.0.0"
          },
          "inputSchema": {
            "type": "object",
            "additionalProperties": false
          },
          "outputSchema": {
            "type": "object",
            "required": [
              "accepted"
            ],
            "properties": {
              "accepted": {
                "const": true
              }
            }
          },
          "effect": "read",
          "permissions": [
            "workspace.read"
          ],
          "timeoutMs": 15000,
          "idempotent": false
        },
        {
          "id": "org.example.acp-agent.operation.approval",
          "capability": {
            "id": "org.example.acp-agent.approval.respond",
            "version": "1.0.0"
          },
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "requestId",
              "decision"
            ],
            "properties": {
              "requestId": {
                "type": "string",
                "minLength": 1
              },
              "decision": {
                "enum": [
                  "accept",
                  "cancel"
                ]
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "resolved",
              "recovery",
              "capabilities"
            ],
            "properties": {
              "resolved": {
                "const": true
              },
              "recovery": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "effect": "read",
          "permissions": [
            "workspace.read"
          ],
          "timeoutMs": 120000,
          "idempotent": false
        }
      ]
    }
  ]
}
